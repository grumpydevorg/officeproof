<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clippit comes from the repository-local feed .local/nuget-feed (relative to this file) while
       it carries our unreleased fixes; eng/pack-clippit.sh
       builds it there (run it once per machine before the first restore). Everything else comes
       from nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="clippit-local" value=".local/nuget-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="clippit-local">
      <package pattern="Clippit" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
