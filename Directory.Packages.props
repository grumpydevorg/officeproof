<Project>
  <!-- Central package management: every version lives here, projects name packages only. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Open XML SDK: the typed OOXML model, packaging and schema validator. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- Clippit: revision accept/reject, list-number retrieval, formatting assembly,
         document comparison. 3.9.2-rmorgans.2 is 3.9.1 plus our eight RevisionProcessor fixes
         (upstream PRs sergey-tihon/Clippit#548-#555), built into a local feed by
         eng/pack-clippit.sh. Return to the nuget.org release once one contains the fixes. -->
    <PackageVersion Include="Clippit" Version="3.9.2-rmorgans.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
